{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "solidays-worker",
  "main": "custom-worker.ts",
  "keep_names": false,
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  // CHAT_LOCAL_DEV 只通过 `worker:dev --var CHAT_LOCAL_DEV:true` 注入本地环境；
  // 绝不在 vars 里配置它，避免生产误开 Turnstile hostname 放宽分支。
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "cache": {
    "enabled": true,
  },
  "images": {
    "binding": "IMAGES",
    "remote": true,
  },
  "routes": [
    {
      "pattern": "solidays.win",
      "custom_domain": true,
    },
    {
      "pattern": "www.solidays.win",
      "custom_domain": true,
    },
  ],
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["0 3 * * *"],
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "solidays-media",
      "remote": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "CHAT_DB",
      "database_name": "solidays-chat",
      "database_id": "990e1948-5748-4bf4-8e84-22ded0110d36",
      "migrations_dir": "./migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "2026081301",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY"],
  },
}
