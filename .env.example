# Public site URL used by metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional external API base. Without it, the app uses its own /api/cards route.
NEXT_PUBLIC_API_URL=

# Optional R2 public custom domain or r2.dev URL. When empty, production uses the Worker's /media route.
NEXT_PUBLIC_R2_PUBLIC_URL=

# Optional music metadata API. Leave empty to hide the music dock without a failing request.
NEXT_PUBLIC_MUSIC_API_URL=

# Public Turnstile site key for the anonymous message widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only Turnstile secret. Configure it with `wrangler secret put` or `.dev.vars`.
TURNSTILE_SECRET_KEY=
