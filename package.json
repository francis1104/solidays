{
  "name": "solidays-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env INIT_CWD=$PWD next dev",
    "build": "next build",
    "serve": "next start",
    "lint": "eslint app components contexts data lib",
    "worker:build": "opennextjs-cloudflare build",
    "worker:dev": "opennextjs-cloudflare build && wrangler dev --var CHAT_LOCAL_DEV:true",
    "worker:deploy": "opennextjs-cloudflare build && cross-env OPEN_NEXT_DEPLOY=true wrangler deploy --config wrangler.jsonc",
    "worker:deploy:ci": "cross-env OPEN_NEXT_DEPLOY=true wrangler deploy --config wrangler.jsonc",
    "worker:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@headlessui/react": "2.2.0",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@shadcn/react": "0.3.0",
    "body-scroll-lock": "^4.0.0-beta.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.540.0",
    "next": "^15.5.21",
    "next-themes": "^0.4.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.16.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.0.5",
    "@tailwindcss/typography": "^0.5.15",
    "@types/react": "^19.0.8",
    "@typescript-eslint/eslint-plugin": "^8.12.0",
    "@typescript-eslint/parser": "^8.12.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.5.21",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "globals": "^15.12.0",
    "postcss": "^8.4.24",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.5",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5.1.3",
    "wrangler": "^4.121.0"
  },
  "packageManager": "yarn@3.6.1"
}
